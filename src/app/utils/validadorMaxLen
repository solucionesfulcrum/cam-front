import { AbstractControl, ValidatorFn } from '@angular/forms';

// Validador personalizado para máximo de dígitos
export function maxDigitsValidator(maxDigits: number): ValidatorFn {
  return (control: AbstractControl): { [key: string]: any } | null => {
    const value = control.value;
    const hasTooManyDigits = value && value.toString().length > maxDigits;
    return hasTooManyDigits ? { 'maxDigits': { value: control.value } } : null;
  };
}